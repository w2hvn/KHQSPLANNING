<Page x:Class="MilitaryTrainingApp.Views.ProgramTreePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:MilitaryTrainingApp.Helpers"
      Title="ProgramTreePage" Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <!-- Converter để kiểm soát hiển thị ô vuông màu Hex -->
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="10"/> <!-- Khoảng cách -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: CÂY NỘI DUNG -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
                <Button Content="Thêm Môn (Root)" Click="BtnAddRoot_Click" Margin="0,0,5,0" Background="{StaticResource AccentBrush}" Foreground="White"/>
                <Button Content="Thêm Nút Con" Click="BtnAddChild_Click" Margin="0,0,5,0"/>
                <Button Content="Xóa Nút" Click="BtnDelete_Click" Margin="0,0,5,0" Background="#CC3333" Foreground="White"/>
                <Button Content="Refresh" Click="BtnRefresh_Click"/>
            </StackPanel>

            <!-- TreeView -->
            <TreeView x:Name="tvProgram" Grid.Row="1" SelectedItemChanged="TvProgram_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <!-- Ô vuông đại diện màu Decor (Chỉ hiển thị cho Level 1) -->
                            <Border Width="12" Height="12" Margin="0,0,5,0" CornerRadius="2"
                                    Background="{Binding BgBrush}"
                                    BorderBrush="Black" BorderThickness="1"
                                    Visibility="{Binding IsRootLevel, Converter={StaticResource BoolToVis}}"/>

                            <!-- Nội dung Text -->
                            <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Name}" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding Capacity, StringFormat='({0} giờ)'}" Foreground="Gray"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- CỘT PHẢI: FORM CHI TIẾT -->
        <Border Grid.Column="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="15">
            <StackPanel>
                <TextBlock Text="THÔNG TIN NỘI DUNG" FontSize="18" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,15"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Mã Nội Dung:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCode" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tên Nội Dung:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtName" Grid.Column="1"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Loại Node:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cboNodeType" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chỉ Tiêu (Giờ):" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <TextBox x:Name="txtCapacity" Grid.Column="1" ToolTip="Nhập số thập phân (VD: 40.5)"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Độ Phức Tạp:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cboComplexityLevel" Grid.Column="1">
                        <ComboBoxItem Content="1 - Cơ bản (GĐ1/Tháng đầu)" Tag="1"/>
                        <ComboBoxItem Content="2 - Nâng cao (GĐ2/Tháng cuối)" Tag="2"/>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Thuộc Tính Bổ Sung:" VerticalAlignment="Top" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1">
                        <CheckBox x:Name="chkIsNightTraining" Content="Bài huấn luyện đêm" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkIsOutdoor" Content="Huấn luyện ngoài thao trường/bãi tập" Margin="0,0,0,5"/>
                        <CheckBox x:Name="chkIsHeavyPhysical" Content="Huấn luyện thể lực nặng" Margin="0,0,0,5"/>
                    </StackPanel>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bài Tiền Đề:" VerticalAlignment="Center" FontWeight="SemiBold"/>
                    <ComboBox x:Name="cboPrerequisiteNode" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </Grid>

                <!-- Cấu hình Trang trí (Dành cho Môn học - Level 1) -->
                <GroupBox Header="Cấu hình Trang trí (Chỉ áp dụng cho Môn học)" BorderBrush="{StaticResource BorderBrush}" Margin="0,0,0,20">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Màu Nền (Hex):" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtBgColorHex" Grid.Column="1"/>
                        </Grid>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Màu Viền (Hex):" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtBorderColorHex" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <Button x:Name="btnSave" Content="Lưu Cập Nhật" Click="BtnSave_Click" Width="150" HorizontalAlignment="Left" Padding="10,8" FontSize="14" FontWeight="Bold"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
