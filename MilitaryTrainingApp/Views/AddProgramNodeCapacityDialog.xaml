<Window x:Class="MilitaryTrainingApp.Views.AddProgramNodeCapacityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thêm Bài Học &amp; Cấp Dung Lượng (Master Prompt v2.0)" Height="600" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Header -->
            <RowDefinition Height="*"/>    <!-- Content -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <TextBlock Text="BỔ SUNG BÀI HỌC VÀ GIAO CHỈ TIÊU (MASTER/SUB)" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource PrimaryColorBrush}" Margin="0,0,0,15"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">
                <!-- Group 1: Identifiers -->
                <GroupBox Header="1. Thông tin cơ bản (Định danh)" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Tên bài học (*):" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtName" Grid.Column="1" Padding="5"/>
                        </Grid>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mã số:" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtCode" Grid.Column="1" Padding="5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Loại hình:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboNodeType" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Group 2: Tactical Flags -->
                <GroupBox Header="2. Thiết lập chiến thuật (Tactical Flags)" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Mức độ Phức tạp:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboComplexity" Grid.Column="1" Padding="5">
                                <ComboBoxItem Content="0 - Không phân loại" Tag="0" IsSelected="True"/>
                                <ComboBoxItem Content="1 - Cơ bản (GĐ1)" Tag="1"/>
                                <ComboBoxItem Content="2 - Nâng cao (GĐ2)" Tag="2"/>
                            </ComboBox>
                        </Grid>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="chkNight" Content="Huấn luyện Đêm" Margin="0,0,15,0"/>
                            <CheckBox x:Name="chkOutdoor" Content="Ngoài trời" Margin="0,0,15,0"/>
                            <CheckBox x:Name="chkHeavy" Content="Thể lực nặng" Margin="0,0,15,0"/>
                            <CheckBox x:Name="chkField" Content="Cần thao trường" Margin="0,0,15,0"/>
                        </WrapPanel>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Yêu cầu Thao trường:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboFacility" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Bài học tiên quyết:" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cboPrerequisite" Grid.Column="1" DisplayMemberPath="Name" SelectedValuePath="Id" Padding="5"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <!-- Group 3: Capacity -->
                <GroupBox Header="3. Giao chỉ tiêu dung lượng (Quotas)" Margin="0,0,0,10">
                    <StackPanel Margin="10">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Master Capacity (Tổng giờ):" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBox x:Name="txtMasterCapacity" Grid.Column="1" Padding="5" Text="0"/>
                        </Grid>
                        <TextBlock Text="Phân bổ Sub-Capacity (cho nút hiện tại):" FontStyle="Italic" Foreground="Gray" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Sub-Capacity (Giờ):" VerticalAlignment="Center"/>
                            <TextBox x:Name="txtSubCapacity" Grid.Column="1" Padding="5" Text="0"/>
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Hủy bỏ" Width="100" Padding="8,5" Margin="0,0,10,0" Click="BtnCancel_Click"/>
            <Button Content="Lưu &amp; Giao Chỉ tiêu" Width="150" Padding="8,5" Background="{DynamicResource PrimaryColorBrush}" Foreground="White" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</Window>
