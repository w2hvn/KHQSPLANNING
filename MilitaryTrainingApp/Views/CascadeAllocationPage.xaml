<Page x:Class="MilitaryTrainingApp.Views.CascadeAllocationPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:helpers="clr-namespace:MilitaryTrainingApp.Helpers"
      Title="CascadeAllocationPage" Background="{StaticResource BackgroundBrush}">

    <Page.Resources>
        <helpers:LevelToIndentConverter x:Key="LevelToIndentConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Style cho DataGrid Row để apply Binding -->
        <Style x:Key="AllocationRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{Binding BgBrush}" />
            <Setter Property="FontWeight" Value="{Binding FontWeight}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E6EBE9" />
                </Trigger>
                <DataTrigger Binding="{Binding IsHighlight}" Value="True">
                    <Setter Property="Background" Value="#FFFACD" /> <!-- LemonChiffon (Vàng nhạt) -->
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="10"/> <!-- Khoảng cách -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- CỘT TRÁI: CÂY THỜI GIAN -->
        <Grid Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Text="CÂY THỜI GIAN KẾ HOẠCH" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

            <TreeView x:Name="tvTimeNodes" Grid.Row="1" SelectedItemChanged="TvTimeNodes_SelectedItemChanged">
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal" Margin="0,4">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>
        </Grid>

        <!-- CỘT PHẢI: LƯỚI PHÂN BỔ THÁC NƯỚC -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Info & Engine Tools -->
            <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="ĐANG PHÂN BỔ CHO: " FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock x:Name="txtParentNodeName" Text="---" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,20,0"/>

                        <TextBlock Text="CẤP CON: " FontWeight="Bold" Foreground="Gray"/>
                        <TextBlock x:Name="txtChildLevelName" Text="---" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="⚙️ Cấu Hình Hệ Thống" Margin="0,0,10,0" Click="BtnSystemConfig_Click" Background="LightGray" Foreground="Black" FontWeight="Bold" Padding="10,5"/>
                        <Button Content="⚡ TỰ ĐỘNG XẾP LỊCH" Click="BtnAutoSchedule_Click" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" Padding="10,5"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- DataGrid -->
            <DataGrid x:Name="dgAllocation" Grid.Row="1"
                      CanUserAddRows="False" AutoGenerateColumns="False"
                      GridLinesVisibility="All" HeadersVisibility="Column"
                      RowStyle="{StaticResource AllocationRowStyle}"
                      CellEditEnding="DgAllocation_CellEditEnding">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Mã Bài" Binding="{Binding ProgramCode}" Width="90" IsReadOnly="True"/>

                    <DataGridTemplateColumn Header="Nội dung huấn luyện" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ProgramName}"
                                           Margin="{Binding Level, Converter={StaticResource LevelToIndentConverter}}"
                                           VerticalAlignment="Center"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="Hạn mức Cha (h)" Binding="{Binding ParentMaxBudget, StringFormat={}{0:0.##}}" Width="110" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Đã chia (h)" Binding="{Binding TotalAllocatedToChildren, StringFormat={}{0:0.##}}" Width="90" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="Blue"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Còn lại (h)" Binding="{Binding RemainingBudget, StringFormat={}{0:0.##}}" Width="90" IsReadOnly="True">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="DarkRed"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Dynamic Columns will be added via Code-Behind here -->
                </DataGrid.Columns>
            </DataGrid>

            <!-- Toolbar Footer & Conflict Log Panel -->
            <StackPanel Grid.Row="2" Orientation="Vertical" Margin="0,10,0,0">

                <GroupBox Header="NHẬT KÝ XỬ LÝ (CONFLICT LOG)" Foreground="DarkRed" FontWeight="Bold" Margin="0,0,0,10" BorderBrush="DarkRed" Visibility="{Binding HasLogs, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}">
                    <ListBox x:Name="lstConflictLogs" MaxHeight="120" ScrollViewer.VerticalScrollBarVisibility="Auto" Background="#FFF5F5" BorderThickness="0" MouseDoubleClick="LstConflictLogs_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="2">
                                    <TextBlock Text="⚠️ [CẦN XỬ LÝ THỦ CÔNG]" Foreground="DarkRed" FontWeight="Bold" Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding ProgramName}" FontWeight="SemiBold" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Reason}" Foreground="Gray" FontStyle="Italic"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>

                <Button x:Name="btnSaveAllocation" Content="Lưu Phân Bổ" Click="BtnSaveAllocation_Click" Padding="20,10" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
