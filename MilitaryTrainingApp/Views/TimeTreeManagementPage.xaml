<Page x:Class="MilitaryTrainingApp.Views.TimeTreeManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Cây Thời gian (Sinh Tự động)" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="CÔNG CỤ XEM CÂY THỜI GIAN" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>
                <TextBlock Text="Cây thời gian được khởi tạo tự động khi tạo mới Kế hoạch. Màn hình này dùng để theo dõi cấu trúc thời gian chuẩn (Năm -> Giai đoạn -> Tháng -> Tuần)." Foreground="Gray" TextWrapping="Wrap" Margin="0,0,0,15"/>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Chọn Kế Hoạch Năm:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cboPlans" Grid.Column="1" Width="250" DisplayMemberPath="Name" SelectedValuePath="Id" SelectionChanged="CboPlans_SelectionChanged"/>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="CẤU TRÚC CÂY THỜI GIAN HIỆN TẠI" FontWeight="Bold" Foreground="Gray" Margin="0,0,0,10"/>

                <TreeView x:Name="tvTimeNodes" Grid.Row="1">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal" Margin="0,4">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding DateRangeStr}" Foreground="Gray" Margin="5,0,0,0" FontStyle="Italic"/>
                            </StackPanel>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Grid>
        </Border>
    </Grid>
</Page>
