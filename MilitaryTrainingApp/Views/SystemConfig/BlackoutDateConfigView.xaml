<UserControl x:Class="MilitaryTrainingApp.Views.SystemConfig.BlackoutDateConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="DANH SÁCH NGÀY NGHỈ LỄ BẮT BUỘC" FontSize="16" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,10"/>

        <DataGrid x:Name="dgBlackoutDates" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="True" CanUserDeleteRows="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Tên Nghỉ Lễ (VD: Tết)" Binding="{Binding HolidayName}" Width="*"/>
                <DataGridTextColumn Header="Từ ngày (yyyy-MM-dd)" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="150"/>
                <DataGridTextColumn Header="Đến ngày (yyyy-MM-dd)" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="150"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Description}" Width="200"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Tải Lại" Width="100" Margin="0,0,10,0" Background="Gray" Click="BtnRefresh_Click"/>
            <Button Content="Lưu Cấu Hình" Width="130" Background="{StaticResource AccentBrush}" FontWeight="Bold" Click="BtnSave_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
