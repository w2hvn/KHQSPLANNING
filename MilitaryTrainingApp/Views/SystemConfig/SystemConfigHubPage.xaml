<Page x:Class="MilitaryTrainingApp.Views.SystemConfig.SystemConfigHubPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:MilitaryTrainingApp.Views.SystemConfig"
      Title="Quản lý Cấu hình Hệ thống" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">
        <TabControl x:Name="tabControl" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <TabItem Header="Định Mức Đối Tượng">
                <local:TargetRuleConfigView x:Name="viewTargetRule"/>
            </TabItem>
            <TabItem Header="Trọng Số Ưu Tiên">
                <local:PriorityRulesConfigView x:Name="viewPriorityRule"/>
            </TabItem>
            <TabItem Header="Ngày Nghỉ Lễ Bắt Buộc">
                <local:BlackoutDateConfigView x:Name="viewBlackoutDate"/>
            </TabItem>
        </TabControl>
    </Grid>
</Page>
