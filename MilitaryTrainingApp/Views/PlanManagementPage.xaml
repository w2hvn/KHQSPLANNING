<Page x:Class="MilitaryTrainingApp.Views.PlanManagementPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Quản lý Kế hoạch Huấn luyện" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Phần 1: Quản lý Kế hoạch (Plan) -->
        <GroupBox Grid.Row="0" Header="DANH SÁCH KẾ HOẠCH NĂM" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource BorderBrush}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <Button Content="Thêm Kế Hoạch" Padding="10,5" Click="BtnAddPlan_Click"/>
                    <Button Content="Xóa Kế Hoạch" Margin="5,0,0,0" Padding="10,5" Background="DarkRed" Foreground="White" Click="BtnDeletePlan_Click"/>
                    <Button Content="Lưu Thay Đổi" Margin="5,0,0,0" Padding="10,5" Background="{StaticResource AccentBrush}" Foreground="White" Click="BtnSavePlans_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgPlans" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionChanged="DgPlans_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Kế Hoạch" Binding="{Binding Code}" Width="150"/>
                        <DataGridTextColumn Header="Tên Kế Hoạch" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="Năm" Binding="{Binding Year}" Width="100"/>
                        <DataGridTextColumn Header="Trạng Thái" Binding="{Binding Status}" Width="120"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <GridSplitter Grid.Row="1" Height="5" HorizontalAlignment="Stretch" Background="LightGray"/>

        <!-- Phần 2: Quản lý Đối tượng Huấn luyện thuộc Kế hoạch (PlanTarget) -->
        <GroupBox Grid.Row="2" Header="ĐỐI TƯỢNG HUẤN LUYỆN (Thuộc Kế Hoạch Đang Chọn)" FontWeight="Bold" Foreground="{StaticResource PrimaryBrush}" BorderBrush="{StaticResource BorderBrush}">
            <Grid Margin="5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                    <ComboBox x:Name="cboTrainingTargets" Width="200" DisplayMemberPath="Name" SelectedValuePath="Id" Margin="0,0,5,0"/>
                    <Button Content="Thêm Đối Tượng Vào Kế Hoạch" Padding="10,5" Click="BtnAddPlanTarget_Click"/>
                    <Button Content="Gỡ Bỏ" Margin="5,0,0,0" Padding="10,5" Background="DarkRed" Foreground="White" Click="BtnRemovePlanTarget_Click"/>
                </StackPanel>

                <DataGrid x:Name="dgPlanTargets" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Mã Đối Tượng" Binding="{Binding Target.Code}" Width="150"/>
                        <DataGridTextColumn Header="Tên Đối Tượng" Binding="{Binding Target.Name}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>
    </Grid>
</Page>
