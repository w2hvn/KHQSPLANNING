<Window x:Class="MilitaryTrainingApp.Views.ConflictResolverWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tạm Dừng: Xung Đột Xếp Lịch" Height="300" Width="500" WindowStartupLocation="CenterOwner" Topmost="True" Background="{StaticResource BackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="⚠️ PHÁT HIỆN XUNG ĐỘT TRỌNG SỐ" FontSize="18" FontWeight="Bold" Foreground="DarkRed" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <TextBlock x:Name="txtMessage" Grid.Row="1" TextWrapping="Wrap" FontSize="14" Margin="0,0,0,15"
                   Text="Hệ thống phát hiện 2 bài học có cùng mức điểm ưu tiên tranh chấp nhau 1 khoảng thời gian trống duy nhất. Vui lòng chọn bài học được ưu tiên trước:"/>

        <ListBox x:Name="lstOptions" Grid.Row="2" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="5">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding DisplayText}" FontSize="14" FontWeight="SemiBold" Padding="5"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="TỰ NHẬP SỐ GIỜ (BỎ QUA)" Background="Gray" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,0,10,0" Click="BtnSkip_Click"/>
            <Button Content="CHỌN &amp; TIẾP TỤC" Background="{StaticResource AccentBrush}" Foreground="White" FontWeight="Bold" Padding="10" Click="BtnContinue_Click"/>
        </StackPanel>
    </Grid>
</Window>
