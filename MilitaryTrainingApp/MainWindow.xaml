<Window x:Class="MilitaryTrainingApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MilitaryTrainingApp.Controls"
        Title="Quản lý Huấn luyện Quân sự" Height="768" Width="1200" WindowStartupLocation="CenterScreen" Background="{StaticResource BackgroundBrush}">

    <Window.Resources>
        <!-- Style for Sidebar Expanders -->
        <Style TargetType="Expander" x:Key="SidebarExpanderStyle">
            <Setter Property="Background" Value="#1A2D24" /> <!-- Darker military green -->
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="#2E4A3E" />
            <Setter Property="Padding" Value="10" />
        </Style>

        <!-- Style for Sidebar Menu Items -->
        <Style TargetType="Button" x:Key="SidebarMenuItemStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#D9A74A" /> <!-- Accent Color -->
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="30,8,10,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#2E4A3E" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/> <!-- Sidebar -->
            <ColumnDefinition Width="*"/>   <!-- Main Content -->
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR (CỘT TRÁI) -->
        <Border Grid.Column="0" Background="#1A2D24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Logo / Title -->
                    <StackPanel Margin="15,20,15,30">
                        <TextBlock Text="ĐIỀU HÀNH HUẤN LUYỆN" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                        <TextBlock Text="AUTO-SCHEDULER ENGINE" Foreground="{StaticResource AccentBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- NHÓM 1 -->
                    <Expander Header="1. LẬP KẾ HOẠCH &amp; NỘI DUNG" IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}">
                        <StackPanel Background="#15241C">
                            <Button Content="1.1. Quản lý Kế hoạch" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_PlanManagement_Click"/>
                            <Button Content="1.2. Quản lý Đối tượng" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_TrainingTarget_Click"/>
                            <Button Content="1.3. Cây Thời Gian" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_TimeTree_Click"/>
                            <Button Content="1.4. Cây Nội dung Huấn luyện" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_ProgramTree_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- NHÓM 2 -->
                    <Expander Header="2. LẬP LỊCH &amp; PHÂN BỔ" IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}">
                        <StackPanel Background="#15241C">
                            <Button Content="2.1. Phân bổ Ma trận Thác nước" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_CascadeAllocation_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- NHÓM 3 -->
                    <Expander Header="3. BÁO CÁO &amp; XUẤT BẢN" IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}">
                        <StackPanel Background="#15241C">
                            <Button Content="3.1. Báo cáo Tiến độ (Timeline)" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_TimelineReport_Click"/>
                            <Button Content="3.2. Báo cáo Cân bằng (Placeholder)" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_ProgressReport_Click"/>
                            <Button Content="3.3. Xuất Tiến trình biểu (Excel)" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_ExcelExport_Click"/>
                        </StackPanel>
                    </Expander>

                    <!-- NHÓM 4 -->
                    <Expander Header="4. CẤU HÌNH HỆ THỐNG" IsExpanded="True" Style="{StaticResource SidebarExpanderStyle}">
                        <StackPanel Background="#15241C">
                            <Button Content="4.1. Hub Cấu hình Hệ thống" Style="{StaticResource SidebarMenuItemStyle}" Click="Nav_SystemConfig_Click"/>
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- MAIN CONTENT (CỘT PHẢI) -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Header Control -->
                <RowDefinition Height="*"/>    <!-- Frame -->
            </Grid.RowDefinitions>

            <!-- Vùng HeaderControl (Global Context) -->
            <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" BorderThickness="0,0,0,2" BorderBrush="{StaticResource AccentBrush}">
                <controls:HeaderControl x:Name="TopHeaderControl"/>
            </Border>

            <!-- Vùng làm việc chính -->
            <Frame x:Name="mainFrame" Grid.Row="1" NavigationUIVisibility="Hidden"/>
        </Grid>
    </Grid>
</Window>
